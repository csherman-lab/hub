# Hub — copy to .env.local and fill in your values
# NEVER commit .env.local to git

# xAI / Grok — powers chat, knowledge, and voice (required)
XAI_API_KEY=xai-your-key-here

# App URL (for OAuth redirects in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — Google OAuth for Gmail & Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Optional — OpenAI (fallback later)
OPENAI_API_KEY=
